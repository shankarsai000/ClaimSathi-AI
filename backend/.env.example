# ClaimSathi AI - Backend Configuration Example (Multi-Language)
APP_ENV=development
APP_PORT=8000
DATABASE_URL=sqlite:///./claimsathi.db

# Gnani AI API Key (Obtain from https://docs.gnani.ai)
GNANI_API_KEY_ID=your_gnani_api_key_id_here

# ── Speech-to-Text (Gnani Prisma) ──────────────────────────────
# Model: prisma-v3.0 supports unified multilingual recognition across all 10+ Indian languages
# Supported STT Models: prisma-v3.0, prisma-v2.5, gnani-prisma-v2.5
GNANI_STT_MODEL=prisma-v3.0

# Language: Use 'indic-auto' for automatic language detection across all Indian languages,
# or specify any BCP-47 code:
#   indic-auto : Auto-detect all 10+ Indian languages (Hindi, Kannada, Tamil, Telugu,
#                Marathi, Bengali, Gujarati, Malayalam, Punjabi, Urdu, Indian English)
#   hi-IN      : Hindi / Hinglish
#   en-IN      : Indian English
#   kn-IN      : Kannada / Kanglish
#   ta-IN      : Tamil / Tanglish
#   te-IN      : Telugu / Tenglish
#   mr-IN      : Marathi
#   bn-IN      : Bengali
#   gu-IN      : Gujarati
#   ml-IN      : Malayalam
#   pa-IN      : Punjabi
#   ur-IN      : Urdu
GNANI_STT_LANGUAGE_CODE=indic-auto

# Prisma v3.0 Writing Modes:
#   transcribe   : Clean text with Inverse Text Normalization (numbers/dates to digits)
#   codemix      : Preserves regional script + English words in Latin script
#   transliterate: Entire transcript in English/Latin letters
#   verbatim     : Preserves all filler words and raw speech
GNANI_STT_WRITING_MODE=transcribe

# ── Text-to-Speech (Gnani Timbre) ──────────────────────────────
# Supported TTS Models: timbre-v2.5, timbre-v3.0
GNANI_TTS_MODEL=timbre-v2.5
GNANI_TTS_LANGUAGE=hi-IN
GNANI_TTS_VOICE=Nalini
