# ClaimSathi AI - Backend Configuration Example (Multi-Language)
APP_ENV=development
APP_PORT=8080
DATABASE_URL=sqlite:///./claimsathi.db
# For production PostgreSQL / Supabase:
# DATABASE_URL=postgresql://postgres.yourproject:yourpassword@aws-0-region.pooler.supabase.com:5432/postgres

# ── Sprint 1: Security & Authentication Hardening ──────────────
# In production, CLAIMSATHI_JWT_SECRET MUST be a high-entropy string of at least 32 characters.
# Generate one using: python -c "import secrets; print(secrets.token_hex(32))"
CLAIMSATHI_JWT_SECRET=claimsathi-dev-secret-key-2026-not-for-production-min32char
JWT_ALGORITHM=HS256
JWT_EXPIRY_SECONDS=86400
AUTH_RATE_LIMIT_MAX_ATTEMPTS=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=3

# Gnani AI API Key (Obtain from https://docs.gnani.ai)
GNANI_API_KEY_ID=your_gnani_api_key_id_here

# ── Speech-to-Text (Gnani Prisma) ──────────────────────────────
# Model: prisma-v3.0 supports unified multilingual recognition across all 10+ Indian languages
# Supported STT Models: prisma-v3.0, prisma-v2.5, gnani-prisma-v2.5
GNANI_STT_MODEL=prisma-v3.0

# Language: Use 'indic-auto' for automatic language detection across all Indian languages,
# or specify any BCP-47 code:
#   indic-auto : Auto-detect all 10+ Indian languages (Hindi, Kannada, Tamil, Telugu,
#                Marathi, Bengali, Gujarati, Malayalam, Punjabi, Urdu, Indian English)
#   hi-IN      : Hindi / Hinglish
#   en-IN      : Indian English
#   kn-IN      : Kannada / Kanglish
#   ta-IN      : Tamil / Tanglish
#   te-IN      : Telugu / Tenglish
#   mr-IN      : Marathi
#   bn-IN      : Bengali
#   gu-IN      : Gujarati
#   ml-IN      : Malayalam
#   pa-IN      : Punjabi
#   ur-IN      : Urdu
GNANI_STT_LANGUAGE_CODE=indic-auto

# Prisma v3.0 Writing Modes:
#   transcribe   : Clean text with Inverse Text Normalization (numbers/dates to digits)
#   codemix      : Preserves regional script + English words in Latin script
#   transliterate: Entire transcript in English/Latin letters
#   verbatim     : Preserves all filler words and raw speech
GNANI_STT_WRITING_MODE=transcribe

# ── Text-to-Speech (Gnani Timbre) ──────────────────────────────
# timbre-v3.0 enables expressive inline audio tags (<sigh>, <pauses>, <slow>, <excited>, <exhales>, etc.)
# with v3 voices (Shivani, Avinash, Kavitha, Riyaa). Legacy timbre-v2.5 uses Nalini.
GNANI_TTS_MODEL=timbre-v3.0
GNANI_TTS_LANGUAGE=hi-IN
GNANI_TTS_VOICE=Shivani

# ── Conversational AI Brain (Approach A: Google Gemini Primary) ──
# Paste your Google AI Studio API key below (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_TIMEOUT_SECONDS=12.0

# ── Conversational AI Brain (Approach B: Lightweight Local Ollama Fallback) ──
# Set OLLAMA_ENABLED=true and run `ollama pull qwen2.5:1.5b` for offline LLM fallback
OLLAMA_ENABLED=false
OLLAMA_API_URL=http://localhost:11434/api/chat
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_TIMEOUT_SECONDS=15.0

# ── Conversational AI Brain (Primary Fast API: Groq OpenAI-Compatible) ──
LLM_API_URL=https://api.groq.com/openai/v1/chat/completions
LLM_API_KEY=your_groq_api_key_here
LLM_MODEL=qwen/qwen3.8-27b
LLM_TIMEOUT_SECONDS=8.0
